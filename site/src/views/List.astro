---
// The home page and the inactive page: one sortable table, live first, then by
// 30-day streamed hours. Home also lists regular schedules (proven ones only).
import Base from '../layouts/Base.astro';
import Roster from '../components/Roster.astro';
import Hero from '../components/Hero.astro';
import { fmt, md, pathFor, strings, type Lang } from '../lib/i18n';
import { statsAtBuild } from '../lib/build-stats';
import { active, inactive } from '../lib/roster';
import { API_BASE, CALENDAR_URL, THUMB_TEMPLATE } from '../lib/api';

interface Props { lang: Lang; page: '' | 'inactive'; }
const { lang, page } = Astro.props;
const all = strings(lang);
const t = all.ui;
const home = page === '';
const streamers = home ? active : inactive;
const text = home ? all.home : all.inactive;
const description = home ? all.meta.description : `${all.inactive.title}. ${all.inactive.intro}`;
// The inactive page, grouped by when each streamer was last live (the bot's
// stats at build time): streamed in the last 30 days; earlier; and nothing
// recorded since recording began (collapsed). Without stats: one list.
let groups: (typeof inactive)[] | null = null, since = '';
if (!home) {
  const st = await Promise.all(inactive.map((s) => statsAtBuild(s.login.toLowerCase())));
  if (st.some(Boolean)) {
    groups = [[], [], []];
    inactive.forEach((s, i) => {
      const x = st[i];
      groups![(x?.hours?.['30d'] ?? 0) > 0 ? 0 : x?.last_live_at ? 1 : 2].push(s);
    });
    const rec = st.find((x) => x?.recording_since)?.recording_since;
    since = rec ? new Intl.DateTimeFormat(lang, { year: 'numeric', month: 'long', day: 'numeric' }).format(new Date(rec)) : '';
  }
}
---
<Base lang={lang} page={page} title={home ? 'InfoSec Streams' : text.title} description={description} live>
  <div id="app" data-page={pathFor(lang, 'streamer')} data-api={API_BASE} data-thumb={THUMB_TEMPLATE} data-ui={JSON.stringify(t)}>
    {home ? <Hero lang={lang} /> : (
      <div class="head">
        <h1>{text.title}</h1>
        <p class="lede" set:html={md(all.inactive.intro, lang)} />
      </div>
    )}

    <section class="panel" id="live-sec" aria-labelledby="live-h" hidden={!home}>
      <h2 class="panel-h" id="live-h"><span class="led on" aria-hidden="true"></span>{t.liveSection} <span class="n" id="live-n"></span></h2>
      <ol class="list live" id="band"></ol>
      {home && <p class="none" id="live-none" aria-live="polite">{t.checkingLive}</p>}
    </section>

    <section class="panel" aria-labelledby="list-h">
      <h2 class="panel-h" id="list-h">{home ? t.allSection : text.listHeading} <span class="n">{streamers.length}</span></h2>
      <div class="cols" id="cols">
        <button type="button" data-sort="name" class="c-name">{t.colStreamer}<svg class="ar" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 4l3-3 3 3M2 6l3 3 3-3" /></svg></button>
        <button type="button" data-sort="hours" class="c-hours" aria-pressed="true"><span class="lg">{t.colHours}</span><span class="sm">{t.colHoursShort}</span><svg class="ar" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 4l3-3 3 3M2 6l3 3 3-3" /></svg></button>
      </div>
      <p class="status" id="badge" role="status"></p>
      {groups ? (
        <>
          {groups[0].length > 0 && <h3 class="grp-h">{all.inactive.groupRecent} <span class="n">{groups[0].length}</span></h3>}
          <Roster lang={lang} streamers={groups[0]} id="rest" />
          {groups[1].length > 0 && <h3 class="grp-h">{all.inactive.groupEarlier} <span class="n">{groups[1].length}</span></h3>}
          <Roster lang={lang} streamers={groups[1]} offset={groups[0].length} />
          {groups[2].length > 0 && (
            <details class="grp">
              <summary class="grp-h">{since ? fmt(all.inactive.groupNone, { date: since }) : all.inactive.groupNoneUndated} <span class="n">{groups[2].length}</span></summary>
              <Roster lang={lang} streamers={groups[2]} offset={groups[0].length + groups[1].length} />
            </details>
          )}
        </>
      ) : <Roster lang={lang} streamers={streamers} id="rest" />}
      <noscript><p class="noscript">{t.noScript}</p></noscript>
    </section>

    {home && (
      <section class="panel regular" aria-labelledby="up-h" id="regular" hidden>
        <div class="regular-h">
          <h2 id="up-h">{t.scheduleHeading}</h2>
          <a class="cal" href={CALENDAR_URL}><svg class="ic" aria-hidden="true"><use href="#i-cal" /></svg>{t.addToCalendar}</a>
        </div>
        <ol class="sched" id="sched"></ol>
      </section>
    )}

    <div class="about">
      <div>
        {home && <p set:html={md(all.home.intro, lang)} />}
        {home && <p set:html={md(all.home.inactiveNote, lang)} />}
        <p set:html={md(all.home.questions, lang)} />
        <h2>{all.resourcesBlurb.heading}</h2>
        <p set:html={md(all.resourcesBlurb.text, lang)} />
      </div>
      <div>
        <h2>{all.credits.heading}</h2>
        <p set:html={md(all.credits.maintainer, lang)} />
        <p set:html={md(all.credits.shoutout, lang)} />
      </div>
      <div>
        <h2>{all.contribute.heading}</h2>
        <p set:html={md(all.contribute.text, lang)} />
      </div>
    </div>
  </div>
  <script src="../scripts/live.ts"></script>
  <script src="../scripts/hero.ts"></script>
</Base>

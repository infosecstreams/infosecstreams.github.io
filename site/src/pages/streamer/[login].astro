---
import View from '../../views/Streamer.astro';
import { active, inactive } from '../../lib/roster';
export const getStaticPaths = () => [...new Set([...active, ...inactive].map((s) => s.login.toLowerCase()))].map((login) => ({ params: { login } }));
---
<View lang="en" login={Astro.params.login as string} />

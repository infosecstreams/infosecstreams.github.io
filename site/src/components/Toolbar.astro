---
import { strings, type Lang } from '../lib/i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = strings(lang).ui;
---
<!-- Shown only with JS (html.js); without it the full ranked list is simply there. -->
<div class="tools" role="search">
  <label class="search">
    <svg class="ic" aria-hidden="true"><use href="#i-search" /></svg>
    <span class="sr">{t.search}</span>
    <input id="q" type="search" placeholder={t.searchPlaceholder} autocomplete="off" spellcheck="false" enterkeyhint="search" />
    <kbd aria-hidden="true" title={t.keyHint}>/</kbd>
  </label>
  <select id="f-lang" aria-label={t.language}><option value="">{t.allLanguages}</option></select>
  <select id="f-sort" aria-label={t.sortLabel}>
    <option value="status">{t.sortLive}</option>
    <option value="hours">{t.sortHours}</option>
    <option value="viewers">{t.sortViewers}</option>
    <option value="name">{t.sortName}</option>
    <option value="lang">{t.sortLang}</option>
  </select>
  <label class="chk"><input id="f-live" type="checkbox" />{t.liveOnly}</label>
</div>

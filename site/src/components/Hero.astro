---
// Home hero: a terminal (real text) beside a server rack drawn by Rive's
// low-level renderer. One sled per listed streamer, most hours first; its LED
// is live status, its bar 30-day hours. Until the runtime has drawn (and with
// JS off) the same rack shows as a static SVG, so nothing moves on load.
import rackSvg from '../assets/rack.svg?raw';
import geo from '../assets/rack.json';
import { strings, type Lang } from '../lib/i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = strings(lang).ui;
---
<section class="hero" id="hero" aria-labelledby="hero-h" data-geo={JSON.stringify(geo)} data-ui={JSON.stringify({ live: t.live, prelive: t.prelive, offline: t.offline, viewers: t.viewers, hours30d: t.hours30d, streamers: t.streamers, nobodyLive: t.nobodyLive, unavailable: t.unavailable, checking: t.checking })}>
  <div class="hero-txt">
    <h1 id="hero-h"><span class="sr">InfoSec Streams: </span>{t.heading}</h1>
    <p class="hero-sub">{t.tagline}</p>
    <div class="term">
      <div class="term-bar" aria-hidden="true"><span class="on">shell</span><span>~/infosec-streams</span></div>
      <div class="term-body" id="term" role="log" aria-live="polite">
        <p class="cmd"><span class="ps">~&gt;</span> streams --live</p>
        <p class="out">{t.checking}</p>
      </div>
    </div>
  </div>
  <figure class="hero-rack">
    <div class="rack-box" id="rack-box">
      <Fragment set:html={rackSvg} />
      <canvas id="rack-c" aria-hidden="true"></canvas>
    </div>
    <figcaption><span>fig. 1</span> {t.rackCaption}</figcaption>
  </figure>
</section>

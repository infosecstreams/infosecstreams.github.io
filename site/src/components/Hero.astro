---
// Home hero: a terminal beside a server rack drawn by Rive's
// low-level renderer. One sled per listed streamer, in random slots; its LED
// is live status, its bar 30-day hours. Until the runtime has drawn (and with
// JS off) the same rack shows as a static SVG, so nothing moves on load.
import rackSvg from '../assets/rack.svg?raw';
import geo from '../assets/rack.json';
// Content-hashed URLs: cached for good (service worker, cache-first), fetched again only when they change.
import rivJs from '../assets/rive/rive.js?url';
import rivWasm from '../assets/rive/rive.wasm?url';
import rivFile from '../assets/rive/rack.riv?url';
import { pathFor, strings, type Lang } from '../lib/i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const S = strings(lang);
const t = S.ui;
---
<section class="hero" id="hero" aria-labelledby="hero-h" data-geo={JSON.stringify(geo)} data-page={pathFor(lang, 'streamer')} data-rive={JSON.stringify([rivJs, rivWasm, rivFile])}>
  <div class="hero-txt">
    <h1 id="hero-h"><span class="sr">InfoSec Streams: </span>{t.heading}</h1>
    <div class="term">
      <div class="term-bar" aria-hidden="true"><span class="on">shell</span><span>~/infosec-streams</span></div>
      <div class="term-body" id="term" aria-hidden="true">
        <p class="cmd"><span class="ps">~&gt;</span> nmap -sCV -p- --min-rate 5000 10.10.11.42</p>
        <p class="out">Starting Nmap 7.95 ( https://nmap.org )</p>
        <p class="cmd"><span class="ps">~&gt;</span> <span class="caret"></span></p>
      </div>
    </div>
  </div>
  <div class="hero-rack">
    <div class="rack-box" id="rack-box" style={`aspect-ratio:${geo.width}/${geo.height};--ring:${(geo.frame[1] / geo.height) * 100 - 0.8}% ${(geo.frame[0] / geo.width) * 100 - 0.8}%`} tabindex="0" role="application" aria-label={t.rackLabel}>
      <Fragment set:html={rackSvg} />
      <canvas id="rack-c" aria-hidden="true"></canvas>
      <!-- Each sled's name plate (hero.ts fills them in); over the SVG and the canvas alike. -->
      <div class="rack-names" aria-hidden="true">
        {geo.sleds.map(([x, y]) => <span dir="auto" style={`left:${((x + geo.name[0]) / geo.width) * 100}%;top:${(y / geo.height) * 100}%;width:${(geo.name[1] / geo.width) * 100}%;height:${(geo.sledH / geo.height) * 100}%`}></span>)}
      </div>
    </div>
    <p class="sr" id="rack-say" aria-live="polite"></p>
    <!-- The console a clicked sled slides out as (console.ts); fixed over the window. -->
    <div class="con" id="con" role="dialog" aria-modal="true" aria-labelledby="con-n" tabindex="-1" hidden data-ui={JSON.stringify({ ...S.streamer, close: t.close, allStats: t.allStats, livePlayer: t.livePlayer, copyLink: t.copyLink, linkCopied: t.linkCopied, hoursShort: t.hoursShort })}>
      <div class="con-bg"></div>
      <div class="con-floor" aria-hidden="true"></div>
      <canvas aria-hidden="true"></canvas>
      <div class="con-sled" aria-hidden="true">
        <div class="sled-top"></div><div class="sled-l"></div><div class="sled-r"></div>
        <div class="con-sf"><canvas></canvas><div class="con-tag"></div></div>
      </div>
      <div class="con-lid">
        <div class="con-back" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        <div class="con-face">
          <span class="con-hinge" aria-hidden="true"></span><span class="con-hinge" aria-hidden="true"></span>
          <span class="con-chin" aria-hidden="true"><i></i><i></i><i></i><i></i><b></b></span>
          <div class="con-scr"></div>
        </div>
      </div>
    </div>
  </div>
</section>
